digraph {
	"0:0" [shape=doublecircle, color=darkviolet]; 
	"0:0" -> "0:0" [label="a"]; 
	"1:0" [shape=doublecircle]; "1:1" [shape=doublecircle, color=darkviolet]; 
	"1:0" -> "1:1" [label="a"]; "1:0" -> "1:0" [label="aa"]; "1:1" -> "1:-1" [label="a, aa"]; 
	"1:1" -> "1:0" [style=dashed]; 
	"2:0" [shape=doublecircle]; "2:1" [shape=doublecircle]; "2:2" [shape=doublecircle, color=darkviolet]; 
	"2:0" -> "2:1" [label="a"]; "2:0" -> "2:2" [label="aa"]; "2:1" -> "2:-1" [label="a, aa, aaaa"]; "2:0" -> "2:0" [label="aaaa"]; "2:2" -> "2:-1" [label="aa, aaaa"]; 
	"2:1" -> "2:0" [style=dashed]; "2:2" -> "2:0" [style=dashed]; 
	"3:0" [shape=doublecircle]; "3:1" [shape=doublecircle]; "3:2" [shape=doublecircle]; "3:3" [shape=doublecircle, color=darkviolet]; 
	"3:0" -> "3:1" [label="a"]; "3:0" -> "3:2" [label="aa"]; "3:1" -> "3:-1" [label="a, aa, aaaa, aaaaaaaa"]; "3:0" -> "3:3" [label="aaaa"]; "3:2" -> "3:-1" [label="aa, aaaa, aaaaaaaa"]; "3:0" -> "3:0" [label="aaaaaaaa"]; "3:3" -> "3:-1" [label="aaaa, aaaaaaaa"]; 
	"3:1" -> "3:0" [style=dashed]; "3:2" -> "3:0" [style=dashed]; "3:3" -> "3:0" [style=dashed]; 
}
